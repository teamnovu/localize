{
    "name": "teamnovu/localize",
    "description": "Localize allows you to easily translate i18n files within Statamic",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Teamnovu\\Localize\\": "src"
        }
    },
    "authors": [
        {
            "name": "Patrick Stillhart",
            "email": "patrick@stillh.art"
        },
        {
            "name": "Oguz Han Asnaz",
            "email": "oguzhan.asnaz@novu.ch"
        }
    ],
    "require": {
        "statamic/cms": "^6.0",
        "pixelfear/composer-dist-plugin": "^0.1.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Localize",
            "description": "Localize addon"
        },
        "laravel": {
            "providers": [
                "Teamnovu\\Localize\\ServiceProvider"
            ]
        },
        "download-dist": {
            "url": "https://github.com/teamnovu/localize/releases/download/{$version}/dist.tar.gz",
            "path": "resources/dist/build"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
