{
    "name": "teamnovu/localize",
    "autoload": {
        "psr-4": {
            "Teamnovu\\Localize\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teamnovu\\Localize\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Localize",
            "description": "Localize addon"
        },
        "laravel": {
            "providers": [
                "Teamnovu\\Localize\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
